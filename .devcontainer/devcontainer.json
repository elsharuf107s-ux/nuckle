{
  "name": "Pokémon Redstone",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5300],
  "portsAttributes": {
    "5300": { "label": "Pokémon Redstone", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash scripts/setup-dev.sh",
  "postStartCommand": "bash scripts/start-dev.sh",
  "remoteUser": "vscode"
}
